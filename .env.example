# Copiez ce fichier en ".env.local" puis remplissez les valeurs.
# Ne mettez JAMAIS .env.local sur GitHub (il est déjà dans .gitignore).

# --- Base de données PostgreSQL (Supabase : bouton "Connect" > "Transaction pooler") ---
DATABASE_URL=postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# --- Secret des sessions admin : une longue chaîne aléatoire (32 caractères minimum) ---
# Pour en générer un :  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Adresse publique du site (pour le SEO et l'aperçu Facebook) ---
NEXT_PUBLIC_SITE_URL=http://localhost:10000

# --- Bouton WhatsApp : numéro au format international sans + ni espaces (ex : 21620123456). Vide = bouton masqué ---
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Pixel Meta : identifiant du pixel. Vide = pixel désactivé ---
NEXT_PUBLIC_META_PIXEL_ID=
